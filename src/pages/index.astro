---
import "../styles/global.css";

const stableVersion = "2.1.x";
const developmentVersion = "2.2.0-dev.x";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="Waypoints Next Gen improves waypoint creation in Vintage Story with better controls, automatic suggestions and icon matching."
    />

    <title>Waypoints Next Gen</title>
  </head>

  <body>
    <header class="header">
      <div class="container nav">
        <a class="brand" href="#top">Waypoints Next Gen</a>

        <nav>
          <a href="#features">Features</a>
          <a href="#automatic">Automatic Waypoints</a>
          <a href="#versions">Versions</a>
          <a href="#compatibility">Compatibility</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="container hero-content">
          <div>
            <span class="eyebrow">Vintage Story Mod</span>

            <h1>Waypoints,<br />made better.</h1>

            <p class="hero-description">
              Waypoints Next Gen improves waypoint creation with a cleaner
              workflow, expanded icon support and automatic target suggestions.
            </p>

            <div class="hero-actions">
              <a
                class="button primary"
                href="https://github.com/YOUR-USERNAME/YOUR-REPOSITORY"
              >
                View on GitHub
              </a>

              <a
                class="button secondary"
                href="https://github.com/YOUR-USERNAME/YOUR-REPOSITORY/releases"
              >
                Download
              </a>
            </div>

            <div class="version-note">
              <span class="status-dot"></span>
              Development version: {developmentVersion}
            </div>
          </div>

          <div class="hero-card">
            <div class="waypoint-preview">
              <div class="preview-icon">◆</div>

              <div>
                <strong>Automatic Waypoint</strong>
                <span>Target detected</span>
              </div>

              <kbd>V</kbd>
            </div>

            <div class="preview-list">
              <div>
                <span>Target</span>
                <strong>Creature / Block</strong>
              </div>

              <div>
                <span>Name</span>
                <strong>Automatic</strong>
              </div>

              <div>
                <span>Icon</span>
                <strong>Best match</strong>
              </div>

              <div>
                <span>Position</span>
                <strong>Target position</strong>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="features">
        <div class="container">
          <div class="section-heading">
            <span class="eyebrow">Features</span>
            <h2>More convenient waypoint management.</h2>
          </div>

          <div class="feature-grid">
            <article class="card">
              <span class="card-number">01</span>
              <h3>Expanded Icons</h3>
              <p>
                More waypoint icons and organized categories make it easier to
                distinguish locations at a glance.
              </p>
            </article>

            <article class="card">
              <span class="card-number">02</span>
              <h3>Fast Creation</h3>
              <p>
                Quickly create a waypoint using the configured hotkey without
                navigating through unnecessary menus.
              </p>
            </article>

            <article class="card">
              <span class="card-number">03</span>
              <h3>Automatic Suggestions</h3>
              <p>
                The mod can detect what you are looking at and suggest a name,
                icon and position automatically.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section highlight-section" id="automatic">
        <div class="container split">
          <div>
            <span class="eyebrow">Experimental</span>

            <h2>Automatic waypoint suggestions</h2>

            <p>
              Automatic waypoint suggestions are an experimental feature
              introduced in <strong>2.2.0-dev.x</strong>, designed primarily to
              work with content added by other mods without requiring manual
              configuration.
            </p>

            <p>
              When you press the <kbd>V</kbd> key while looking at a block or
              creature, the mod attempts to automatically detect the target and
              create a waypoint with an appropriate name, icon and position
              based on the available technical data and localization.
            </p>

            <p class="muted">
              This feature is still under development, so some matches may be
              inaccurate.
            </p>
          </div>

          <div class="steps">
            <div class="step">
              <span>1</span>
              <div>
                <strong>Look at a target</strong>
                <p>A creature or supported block can be detected.</p>
              </div>
            </div>

            <div class="step">
              <span>2</span>
              <div>
                <strong>Press V</strong>
                <p>The waypoint creation dialog opens for the target.</p>
              </div>
            </div>

            <div class="step">
              <span>3</span>
              <div>
                <strong>Suggestion is generated</strong>
                <p>Name, icon and target position are filled automatically.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="versions">
        <div class="container">
          <div class="section-heading">
            <span class="eyebrow">Versions</span>
            <h2>Choose how experimental you want to be.</h2>
          </div>

          <div class="version-grid">
            <article class="version-card">
              <span class="badge stable">Stable</span>
              <h3>{stableVersion}</h3>
              <p>
                Recommended for normal gameplay where stability is the priority.
              </p>
            </article>

            <article class="version-card featured">
              <span class="badge development">Development</span>
              <h3>{developmentVersion}</h3>
              <p>
                Includes features currently being tested, such as automatic
                waypoint suggestions.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section" id="compatibility">
        <div class="container compatibility">
          <div>
            <span class="eyebrow">Compatibility</span>
            <h2>Designed to work with modded content.</h2>
          </div>

          <p>
            The automatic suggestion system uses technical identifiers and
            localization data provided by the game and installed mods. Its goal
            is to recognize modded creatures and blocks without requiring a
            separate configuration for every mod.
          </p>
        </div>
      </section>

      <section class="section final-section">
        <div class="container final-card">
          <div>
            <span class="eyebrow">Waypoints Next Gen</span>
            <h2>Explore the project.</h2>
          </div>

          <div class="hero-actions">
            <a
              class="button primary"
              href="https://github.com/YOUR-USERNAME/YOUR-REPOSITORY"
            >
              GitHub
            </a>

            <a
              class="button secondary"
              href="https://github.com/YOUR-USERNAME/YOUR-REPOSITORY/issues"
            >
              Report an issue
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-content">
        <span>Waypoints Next Gen</span>
        <span>Vintage Story Mod</span>
      </div>
    </footer>
  </body>
</html>